{
  "name": "pullvault",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit --incremental false && tsc --project tsconfig.server.json --noEmit --incremental false",
    "verify:connections": "tsx scripts/verify-connections.ts",
    "seed:cards": "tsx scripts/card-seeder.ts",
    "price:refresh:full:dry": "tsx scripts/price-full-refresh.ts --dry-run",
    "price:refresh:full": "tsx scripts/price-full-refresh.ts --commit",
    "backfill:price-liquidity": "tsx scripts/backfill-price-liquidity.ts",
    "backfill:price-liquidity:dry": "tsx scripts/backfill-price-liquidity.ts --dry-run",
    "seed:drop": "tsx scripts/seed-initial-drop.ts",
    "partb:phase0:backfill": "node --import tsx scripts/partb-phase0-backfill.ts",
    "partb:phase0:cold-bootstrap:qa": "node --import tsx scripts/partb-phase0-cold-bootstrap-qa.ts",
    "partb:phase0:cold-bootstrap:qa:keepdb": "node --import tsx scripts/partb-phase0-cold-bootstrap-qa.ts --keep-db",
    "test:partb:phase1:node": "node --import tsx scripts/test-partb-phase1-node.ts",
    "test:partb:phase1:browser": "node --import tsx scripts/test-partb-phase1-browser.ts",
    "test:partb:phase1": "npm run test:partb:phase1:node && npm run test:partb:phase1:browser",
    "test:partb:phase2:exit": "node --import tsx scripts/test-partb-phase2-exit.ts",
    "test:partb:phase2:http": "node --import tsx scripts/test-partb-phase2-http-smoke.ts",
    "test:partb:phase2": "npm run test:partb:phase1 && npm run test:partb:phase2:exit && npm run test:partb:phase2:http",
    "test:partb:phase3": "vitest run src/server/economics/**/*.unit.test.ts",
    "test:partb:phase3:integration": "vitest run src/server/economics/**/*.integration.test.ts",
    "test:partb:phase3:all": "npm run test:partb:phase3 && npm run test:partb:phase3:integration",
    "test:partb:phase4:runtime": "node --import tsx scripts/test-partb-phase4-runtime.ts",
    "test:partb:phase4:runtime:lite": "PARTB_PHASE4_BURST_PARTICIPANT_COUNT=10 PARTB_PHASE4_MAIN_DROP_INVENTORY=3 PARTB_PHASE4_POST_WINDOW_PARTICIPANT_COUNT=3 PARTB_PHASE4_UNIFORMITY_TRIAL_COUNT=4 PARTB_PHASE4_UNIFORMITY_PARTICIPANT_COUNT=6 PARTB_PHASE4_UNIFORMITY_COHORT_SIZE=2 node --import tsx scripts/test-partb-phase4-runtime.ts",
    "test:n1:unit": "node --import tsx scripts/test-n1-deterministic.ts",
    "test:n1:hardening": "node --import tsx scripts/test-n1-hardening.ts",
    "test:n1:concurrency": "node --import tsx scripts/test-n1-concurrency-smoke.ts",
    "test:n1": "npm run test:n1:unit && npm run test:n1:hardening && npm run test:n1:concurrency",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.103.3",
    "decimal.js": "^10.4.3",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "next": "^14.2.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.15",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.59.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
