# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase/Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pullvault
# Set to true when your Postgres provider requires SSL (common in hosted environments).
DATABASE_SSL=false

# Redis (Upstash/Redis compatible)
REDIS_URL=redis://default:password@localhost:6379

# Optional separate pub/sub connections (fallback to REDIS_URL)
REDIS_PUB_URL=
REDIS_SUB_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Card Seeder (Phase 3)
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2/cards
POKEMON_TCG_API_KEY=

# Price Engine (Phase 7)
# true  => API-first pricing with simulation fallback
# false => simulation-only pricing
PRICE_SOURCE_ENABLED=true
