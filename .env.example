# ============================================================
# PullVault Environment Template
# ============================================================

# ============================================================
# 1) REQUIRED (minimum needed for core production functionality)
# ============================================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/pullvault

# Redis
# Required: set REDIS_URL.
# Alternative: leave REDIS_URL empty and set BOTH REDIS_PUB_URL and REDIS_SUB_URL in optional section.
REDIS_URL=redis://default:password@localhost:6379

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fairness / deterministic pack generation
# Used to encrypt server seeds at drop activation and decrypt during purchase-time generation.
PACK_FAIRNESS_SECRET=replace-with-a-long-random-secret

# ============================================================
# 2) OPTIONAL (feature flags, rollout controls, and tuning)
# ============================================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database SSL
# Set to true when your Postgres provider requires SSL (common in hosted environments).
DATABASE_SSL=false

# Optional separate Redis pub/sub connections (fallback to REDIS_URL)
REDIS_PUB_URL=
REDIS_SUB_URL=

# Lottery admission HMAC key (32 random bytes hex recommended).
# Optional, but recommended for waiting-room lottery integrity.
SERVER_LOTTERY_KEY=4f3c9a8b7d2e1c0a9f6b5d4c3e2f1a0b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f

# Purchase observability
# Sampling rate in [0,1]. Default: 1 in development, 0.1 in production.
PURCHASE_OBSERVABILITY_SAMPLE_RATE=1

# Card Seeder (Phase 3)
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2/cards
POKEMON_TCG_API_KEY=

# Price Engine (Phase 7)
# true  => API-first pricing with simulation fallback
# false => simulation-only pricing
PRICE_SOURCE_ENABLED=true

# Price Engine Queue/Worker (Strict Plan)
PRICE_SCHEDULER_ENABLED=true
PRICE_WORKER_ENABLED=true
PRICE_COALESCING_ENABLED=true

# Scheduler / Worker tuning
PRICE_SCHEDULER_INTERVAL_MS=60000
PRICE_WORKER_POLL_INTERVAL_MS=1000
PRICE_WORKER_RECOVERY_INTERVAL_MS=30000
PRICE_WORKER_LOCK_TIMEOUT_MS=120000

# Job batching / retry tuning
PRICE_JOB_SELECTION_LIMIT=250
PRICE_JOB_OWNED_PRIORITY_QUOTA=100
PRICE_SELECTION_MODE=production
# Trial-only owned-card boost controls (used only when PRICE_SELECTION_MODE=trial)
PRICE_TRIAL_OWNED_TARGET_PER_TICK=140
PRICE_TRIAL_OWNED_NEAR_DUE_CAP=60
PRICE_SELECTION_DIAGNOSTICS_ENABLED=false
# Worker/scheduler activity logs (set false to reduce Railway log volume)
PRICE_JOB_ACTIVITY_LOGS_ENABLED=true
PRICE_JOB_CHUNK_SIZE=50
PRICE_JOB_MAX_ATTEMPTS=5
PRICE_JOB_RETRY_BASE_DELAY_MS=5000
PRICE_JOB_RETRY_MAX_DELAY_MS=60000
PRICE_JOB_KEY_BUCKET_MS=60000

# Realtime fanout coalescing
PRICE_UPDATE_COALESCE_WINDOW_MS=2000

# Auctions list realtime coalescing (safe rollout)
# Keep false initially; enable after staging verification.
AUCTIONS_LIST_COALESCING_ENABLED=false
AUCTIONS_LIST_COALESCE_WINDOW_MS=300
AUCTIONS_LIST_COALESCE_MAX_BUFFER=500

# Admin metrics realtime coalescing
ADMIN_METRICS_COALESCING_ENABLED=true
ADMIN_METRICS_COALESCE_WINDOW_MS=500
ADMIN_METRICS_COALESCE_MAX_BUFFER=200

# Next refresh scheduling windows (seconds)
PRICE_REFRESH_HIGH_MIN_SECONDS=60
PRICE_REFRESH_HIGH_MAX_SECONDS=120
PRICE_REFRESH_MEDIUM_MIN_SECONDS=600
PRICE_REFRESH_MEDIUM_MAX_SECONDS=1200
PRICE_REFRESH_LOW_MIN_SECONDS=3600
PRICE_REFRESH_LOW_MAX_SECONDS=14400
PRICE_REFRESH_ILLIQUID_MIN_SECONDS=43200
PRICE_REFRESH_ILLIQUID_MAX_SECONDS=86400
DROP_INVENTORY_RECONCILE_ENABLED=true
DROP_INVENTORY_RECONCILE_INTERVAL_MS=300000
DROP_LOTTERY_CLOSER_ENABLED=true
DROP_LOTTERY_RECONCILE_INTERVAL_MS=2000

# Fairness auditor schedule
FAIRNESS_AUDITOR_ENABLED=true
FAIRNESS_AUDITOR_INTERVAL_MS=86400000

# Global API blanket rate limit (Phase v5.2.1-P6)
GLOBAL_API_RATE_LIMIT_ENABLED=false
GLOBAL_API_RATE_LIMIT_PER_IP_LIMIT=300
GLOBAL_API_RATE_LIMIT_PER_IP_WINDOW_SECONDS=60
GLOBAL_API_RATE_LIMIT_PER_USER_LIMIT=600
GLOBAL_API_RATE_LIMIT_PER_USER_WINDOW_SECONDS=60

# Comma-separated exact path prefixes exempt from blanket rate limiting.
GLOBAL_API_RATE_LIMIT_EXEMPT_PATHS=/api/auth/refresh,/socket.io

# Auto-rebalance on price drift (Phase v5.2.1-P7)
AUTO_REBALANCE_ENABLED=false
AUTO_REBALANCE_DRIFT_THRESHOLD_BPS=500
AUTO_REBALANCE_DEBOUNCE_MS=120000
AUTO_REBALANCE_MIN_INTERVAL_MS=1800000
AUTO_REBALANCE_DRIFT_SAMPLE_MAX_CARDS=500

# Final-window bid confirmation gate (Phase v5.2.1-P8)
FINAL_WINDOW_GATE_ENABLED=true
FINAL_WINDOW_PCT=10
FINAL_WINDOW_MIN_SECONDS=60
FINAL_WINDOW_THROTTLE_PER_USER_LIMIT=1
FINAL_WINDOW_THROTTLE_WINDOW_MS=10000

# Admin Economics Dashboard (Phase 8)
# Admin authorization uses users.role.
# Promote an account with: UPDATE users SET role = 'admin' WHERE email = '...';
ECONOMICS_DEFAULT_WINDOW_HOURS=24
ECONOMICS_MAX_WINDOW_DAYS=31
REVENUE_PROJECTION_WINDOW_DAYS=7
REVENUE_PROJECTION_HORIZON_DAYS=30
# Additional warning threshold used by rebalance simulations.
ECONOMICS_EDGE_OVERSHOOT_WARN_BPS=1000
# Actual house edge must stay within this BPS delta of the per-tier target
# (see TARGET_HOUSE_EDGE_BPS in constants.ts) to avoid an incident banner.
ECONOMICS_INCIDENT_HOUSE_EDGE_DELTA_BPS=1000
# Margin-deviation alerts (Phase v5.2.1-P3)
ECONOMICS_ALERTS_ENABLED=true
ECONOMICS_ALERT_DEDUP_WINDOW_MS=900000
# Optional outbound webhook for alert fanout. If URL is set, secret is required.
ECONOMICS_ALERT_WEBHOOK_URL=
ECONOMICS_ALERT_WEBHOOK_SECRET=
ECONOMICS_ALERT_WEBHOOK_TIMEOUT_MS=3000

# Public aggregate fairness audit (Phase v5.2.1-P1)
# Per-IP request budget for GET /api/fairness/audit/public
PUBLIC_FAIRNESS_AUDIT_RATE_LIMIT_LIMIT=30
PUBLIC_FAIRNESS_AUDIT_RATE_LIMIT_WINDOW_SECONDS=60
# Success-response cache header max-age
PUBLIC_FAIRNESS_AUDIT_CACHE_TTL_SECONDS=300
